# ============================================================================
# Fundo AI Reviewer — Environment Configuration
# Copy this file to `.env` to run live LLM evaluations on uncached transactions:
#   cp .env.example .env
# Note: No API key is needed for offline reproduction (`--use-cache`).
# ============================================================================

# Primary LLM Reviewer (Google Gemini 2.5 Flash)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative LLM Reviewer (OpenAI GPT-4o-mini)
# Used automatically if GEMINI_API_KEY is not set
OPENAI_API_KEY=